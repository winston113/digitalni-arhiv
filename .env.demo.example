# Javni naslov predstavitvene različice, natanko tak, kot ga vidi brskalnik.
DEMO_BASE_URL=https://arhiv-demo.primer.si
# Naslov in vrata na gostitelju, na katera se poveže Caddy.
DEMO_BIND=127.0.0.1:3100
DEMO_TRUST_PROXY=true
# Registracija mora biti vklopljena za prikaz na predstavitvi; po ocenjevanju jo izklopite.
DEMO_REGISTRATION=true
# Skupna omejitev prostora za datoteke vseh uporabnikov.
DEMO_STORAGE_LIMIT_MB=500
# Neobvezno: prijava in registracija prek Zitadela.
DEMO_OIDC_ISSUER=
DEMO_OIDC_CLIENT_ID=
DEMO_OIDC_CLIENT_SECRET=
DEMO_OIDC_NAME=Zitadel
