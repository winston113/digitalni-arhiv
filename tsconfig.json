{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
