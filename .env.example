# Naslov, na katerem uporabniki odprejo aplikacijo. Mora biti točen, sicer prijava ne deluje.
BASE_URL=https://arhiv.primer.si

# Kje posluša vsebnik na gostitelju. Če je Caddy na drugem strežniku, vpišite 0.0.0.0:3000
# ali naslov v domačem omrežju in vrata zaščitite s požarnim zidom.
BIND=127.0.0.1:3000

# Kje so podatki: ime nosilca (privzeto) ali mapa na gostitelju, ki pripada uporabniku PUID:PGID.
# Na Unraidu: DATA=/mnt/cache/appdata/digitalni-arhiv/data, PUID=99, PGID=100.
DATA=podatki
PUID=1000
PGID=1000

# true samo za povratnim posrednikom (Caddy), ki nastavi X-Forwarded-For.
TRUST_PROXY=true

# Registracija novih uporabnikov z e-pošto in geslom. Prijava z geslom je vedno na voljo.
REGISTRATION=true

# OpenID Connect, na primer Zitadel. Neobvezno: nastavite ga lahko tudi v aplikaciji (Skrbništvo, Zunanja prijava).
# Če je nastavljen tu, ima prednost in ga v aplikaciji ni mogoče spremeniti. Skrivnost pustite prazno pri PKCE.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Zitadel
# none, client_secret_basic ali client_secret_post. Prazno: POST, če je skrivnost nastavljena, sicer none.
OIDC_METHOD=
OIDC_SCOPES=openid profile email
# Registracija novih uporabnikov prek ponudnika; od zgornje registracije je ločena.
OIDC_REGISTRATION=true

# Pošta, na primer Mailjet. Neobvezno: nastavite jo lahko tudi v aplikaciji (Skrbništvo, E-pošta).
# Če je nastavljena tu, ima prednost in je v aplikaciji ni mogoče spremeniti.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# starttls, tls ali none. Prazno: tls za vrata 465, sicer starttls.
SMTP_SECURITY=

# Skupna omejitev prostora za datoteke v MB. Prazno: brez omejitve.
STORAGE_LIMIT_MB=

# Prepoznava besedila na skeniranih straneh (OCR) in jeziki. Slika vsebuje slv in eng.
OCR=true
OCR_LANGUAGES=slv+eng
# Koliko strani se prepoznava hkrati. auto: glede na procesorska jedra in pomnilnik vsebnika, največ 8.
# Za vsako obdelavo računajte približno 180 MB pomnilnika.
OCR_WORKERS=auto

# Skrivnost za seje, vsaj 32 znakov. Prazno: ustvari se samodejno v podatkovni mapi.
SECRET=
