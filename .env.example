# Naslov, na katerem uporabniki odprejo aplikacijo. Mora biti točen, sicer prijava ne deluje.
BASE_URL=https://arhiv.primer.si

# Kje posluša vsebnik na gostitelju. Če je Caddy na drugem strežniku, vpišite 0.0.0.0:3000
# ali naslov v domačem omrežju in vrata zaščitite s požarnim zidom.
BIND=127.0.0.1:3000

# true samo za povratnim posrednikom (Caddy), ki nastavi X-Forwarded-For.
TRUST_PROXY=true

# Prijava z e-pošto in geslom ter registracija novih uporabnikov.
LOCAL_LOGIN=true
REGISTRATION=true

# OpenID Connect, na primer Zitadel. Neobvezno. Skrivnost pustite prazno pri PKCE.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Zitadel
# Registracija novih uporabnikov prek ponudnika; od zgornje registracije je ločena.
OIDC_REGISTRATION=true

# Pošta za ponastavitev gesla, na primer Mailjet. Neobvezno.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Skupna omejitev prostora za datoteke v MB. Prazno: brez omejitve.
STORAGE_LIMIT_MB=

# Skrivnost za seje, vsaj 32 znakov. Prazno: ustvari se samodejno v podatkovni mapi.
SECRET=
