{
  "name": "digitalni-arhiv",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "repository": "github:winston113/digitalni-arhiv",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts src/server/cli.ts src/server/regex-worker.ts --bundle --platform=node --format=esm --target=node24 --packages=external --splitting --outdir=dist/server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "licences": "node scripts/licences.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@hono/node-server": "^2.1.11",
    "better-auth": "^1.7.27",
    "better-sqlite3": "^13.2.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.21",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "docx-preview": "^0.4.1",
    "esbuild": "^0.28.2",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "lucide-react": "^1.78.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
